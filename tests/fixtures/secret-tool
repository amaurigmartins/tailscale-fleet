#!/usr/bin/env bash
set -Eeuo pipefail

: "${MOCK_SECRET_STORE:?}"

action="${1:-}"
shift || true
machine=""
username=""
args=("$@")
for ((i=0; i<${#args[@]}; i++)); do
    case "${args[$i]}" in
        machine) machine="${args[$((i + 1))]:-}" ;;
        username) username="${args[$((i + 1))]:-}" ;;
    esac
done
key="$(printf '%s|%s' "$machine" "${username:-__legacy__}" | cksum | awk '{print $1}')"
store_path="$MOCK_SECRET_STORE.$key"

case "$action" in
    store)
        secret="$(cat)"
        printf '%s' "$secret" > "$store_path"
        ;;
    lookup)
        [[ -f "$store_path" ]] || exit 1
        cat "$store_path"
        ;;
    clear)
        [[ -f "$store_path" ]] || exit 1
        rm -f -- "$store_path"
        ;;
    *)
        exit 2
        ;;
esac
