#!/usr/bin/env bash
set -Eeuo pipefail

: "${MOCK_SECRET_STORE:?}"

case "${1:-}" in
    store)
        secret="$(cat)"
        printf '%s' "$secret" > "$MOCK_SECRET_STORE"
        ;;
    lookup)
        [[ -f "$MOCK_SECRET_STORE" ]] || exit 1
        cat "$MOCK_SECRET_STORE"
        ;;
    clear)
        rm -f -- "$MOCK_SECRET_STORE"
        ;;
    *)
        exit 2
        ;;
esac
