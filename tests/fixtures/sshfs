#!/usr/bin/env bash
set -eu

: "${MOCK_SSHFS_LOG:?}"
: "${MOCK_MOUNT_STATE:?}"
printf '%s\n' "$@" >> "$MOCK_SSHFS_LOG"

[[ $# -ge 2 ]] || exit 2
mountpoint="$2"
shift 2
fsname=""
while [[ $# -gt 0 ]]; do
    if [[ "$1" == -o && $# -ge 2 && "$2" == fsname=* ]]; then
        fsname="${2#fsname=}"
        shift 2
    else
        shift
    fi
done
[[ -n "$fsname" ]] || exit 2
if [[ -n "${MOCK_SSHFS_FAIL_SHARE:-}" && "$fsname" == */"$MOCK_SSHFS_FAIL_SHARE" ]]; then
    exit 23
fi
printf '%s|fuse.sshfs|%s\n' "$mountpoint" "$fsname" >> "$MOCK_MOUNT_STATE"
